# URL de conexión a PostgreSQL (docker compose up -d postgres_db)
DATABASE_URL=postgresql://restostock:restostock@localhost:5432/restostock

# Secreto para firmar los JWT (cambiar por uno propio en producción)
JWT_SECRET=ejemplo_secreto_no_usar_en_produccion

# Expiración del token (default: 12h)
JWT_EXPIRES_IN=12h

# Puerto del servidor API (default: 8080)
PORT=8080

# Orígenes permitidos por CORS, separados por coma (whitelist). Sin Origin (app nativa/curl) se permite.
ALLOWED_ORIGINS=http://localhost:3000

# Entorno de ejecución (development | test | production)
